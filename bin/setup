#!/usr/bin/env bash
set -euo pipefail

cd "$(dirname "$0")/.."

ruby_version() {
  ruby -e 'print RUBY_VERSION' 2>/dev/null || true
}

if ! ruby -e 'require "rubygems"; v = Gem::Version.new(RUBY_VERSION); exit(v >= Gem::Version.new("3.3.0") && v < Gem::Version.new("3.4") ? 0 : 1)' 2>/dev/null; then
  cat <<EOF
Ruby $(ruby_version || echo "not found") is not supported.

This site uses the same stack as GitHub Pages: Ruby 3.3.x + github-pages gem.
See .ruby-version and https://pages.github.com/versions/

Quick setup with rbenv (recommended):

  brew install rbenv ruby-build
  rbenv install 3.3.7
  rbenv local 3.3.7
  gem install bundler
  cd $(pwd)
  bundle install

Or with Homebrew Ruby 3.3 (not Ruby 4):

  brew install ruby@3.3
  export PATH="/opt/homebrew/opt/ruby@3.3/bin:\$PATH"
  gem install bundler
  bundle install

Then preview with: bundle exec jekyll serve
EOF
  exit 1
fi

echo "Using Ruby $(ruby_version)"
bundle install
echo
echo "Gem versions (should match GitHub Pages):"
bundle exec github-pages versions 2>/dev/null | head -5 || true
echo
echo "Done. Run: bundle exec jekyll serve"